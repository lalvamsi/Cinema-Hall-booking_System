{
  "name": "cinema-hall-ticket-booking-system",
  "version": "1.0.0",
  "description": "Full-stack MERN Cinema Hall Ticket Booking System",
  "scripts": {
    "start": "node backend/server.js",
    "build": "cd frontend && npm install && npm run build",
    "server": "npm --prefix backend start",
    "server:dev": "npm --prefix backend run dev",
    "client": "npm --prefix frontend run dev",
    "client:build": "npm --prefix frontend run build",
    "seed": "npm --prefix backend run seed",
    "install:all": "npm --prefix backend install && npm --prefix frontend install"
  },
  "keywords": ["mern", "cinema-booking", "movie-tickets", "react", "node", "express", "mongodb"],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mongoose": "^8.9.5"
  },
  "engines": {
    "node": ">=18.x"
  }
}
